# Local development only. Copy to .env; never commit .env.
SPRING_PROFILES_ACTIVE=dev-seed
POSTGRES_USER=domestic_admin
POSTGRES_PASSWORD=local_admin_change_me
POSTGRES_PORT=5433
DB_HOST=localhost
DB_PORT=5433
IDENTITY_DB_USER=identity_app
IDENTITY_DB_PASSWORD=local_identity_change_me
# Optional: create the first active admin only. Set in ignored .env, then remove after setup.
IDENTITY_BOOTSTRAP_EMAIL=
IDENTITY_BOOTSTRAP_PHONE=
IDENTITY_BOOTSTRAP_PASSWORD=
# Registration email delivery. Gmail requires an App Password, stored only in ignored .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
IDENTITY_MAIL_FROM=
CATALOG_DB_USER=catalog_app
CATALOG_DB_PASSWORD=local_catalog_change_me
BOOKING_DB_USER=booking_app
BOOKING_DB_PASSWORD=local_booking_change_me
FINANCE_DB_USER=finance_app
FINANCE_DB_PASSWORD=local_finance_change_me

# Real payOS payment channel. Keep secrets only in ignored .env.
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_ACCOUNT_NUMBER=
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=

# Community image/video storage (secret stays in backend).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AI_DB_USER=ai_app
AI_DB_PASSWORD=local_ai_change_me
NOTIFICATION_DB_USER=notification_app
NOTIFICATION_DB_PASSWORD=local_notification_change_me
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8086,http://localhost:8090
# Shared secret for authenticated internal notification events, generated locally.
INTERNAL_SERVICE_TOKEN=

# Optional private AI adapter: POST messages/instructions; response must contain content.
AI_PROVIDER_URL=
AI_PROVIDER_KEY=

# LiveKit Cloud (Booking only). Never put these secrets in frontend.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
EXPO_PUSH_ENABLED=false
EXPO_PUSH_ACCESS_TOKEN=
